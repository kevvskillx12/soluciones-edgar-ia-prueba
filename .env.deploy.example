APP_NAME="Soluciones Edgar IA"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://TU_IP_O_DOMINIO:8000
APP_PORT=8000

# Genera una nueva con:
# php artisan key:generate --show
APP_KEY=base64:CAMBIA_ESTA_LLAVE

QUEUE_CONNECTION=database

# Para demo puedes dejar log. Para correos reales, configura SMTP.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Soluciones Edgar IA"

# Solo si usarás Cloudflare Tunnel permanente con dominio.
CLOUDFLARE_TUNNEL_TOKEN=

# En un servidor nuevo deja true para crear admin, servicios y catálogo inicial.
RUN_SEEDERS=true
